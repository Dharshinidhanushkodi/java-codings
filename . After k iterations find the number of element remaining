import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int arr[]=new int[n];
		for(int i=0;i<n;i++)
		{
		    arr[i]=sc.nextInt();
		}
		int t=sc.nextInt();
		int sum=0;
		for(int i=0;i<t;i++)
		{ 
		    int max=0;
		    for(int j=1;j<n;j++)
		    {
		        if(arr[j]>arr[max])
		        {
		            max=j;
		        }
		    }
		    arr[max]=(int)Math.sqrt(arr[max]);
		}
		for(int i=0;i<n;i++)
		{
		    sum=sum+arr[i];
		}
		System.out.print(sum);
	}
}
