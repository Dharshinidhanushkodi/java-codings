import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		String num=sc.next();
		char arr[]=num.toCharArray();
		Arrays.sort(arr);
		if(arr[0]=='0')
		{
		    for(int i=1;i<arr.length;i++)
		    {
		        if(arr[i]!='0')
		        {
		         char temp=arr[i];
		         arr[i]=arr[0];
		         arr[0]=temp;
		         break;
		        }
		    }
		}
		for(int i=0;i<arr.length;i++)
		{
		    System.out.print(arr[i]);
		}
	}
}
