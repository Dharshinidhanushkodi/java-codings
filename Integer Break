import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		if(n==2)
		{
		    System.out.print("1");
		    return;
		}
		if(n==3)
		{
		    System.out.print("2");
		    return;
		}
		int p=1;
		while(n>4)
		{
		    p=p*3;
		    n=n-3;
		}
		System.out.print(n*p);
	}
}
