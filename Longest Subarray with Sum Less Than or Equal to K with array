import java.util.*;
public class Main
{
	public static void main(String[] args) {
          Scanner sc=new Scanner(System.in);
          int n=sc.nextInt();
          int arr[]=new int[n];
          for(int i=0;i<n;i++)
          {
              arr[i]=sc.nextInt();
          }
          int k=sc.nextInt();
          int j=0;
          int sum=0;
          int max=0;
          int start=0;
          for(int i=0;i<n;i++)
          {
              sum=sum+arr[i];
          while(sum>k)
          {
             sum=sum-arr[j]; 
             j++;
          }
          if(i-j+1>max)
          {
              max=i-j+1;
              start=j;
          }
          }
          for(int i=start;i<start+max;i++)
          {
              System.out.print(arr[i]+" ");
          }
	}
}
