import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int arr[]=new int[n];
		for(int i=0;i<n;i++)
		{
		    arr[i]=sc.nextInt();
		}
		int l=0;
		int r=n-1;
		int max=Integer.MIN_VALUE;
		while(l<r)
		{
		    int d= Math.min(arr[l],arr[r])*(r-l);
		    max=Math.max(d,max);
		    if(arr[l]<arr[r])
		    {
		        l++;
		    }
		    else{
		        r--;
		    }
		}
		System.out.print(max);
	}
}
